{
    "settings": {
        "analysis": {
            "char_filter": {
                "location_char_filter": {
                    "type": "pattern_replace",
                    "pattern": "[^\\p{L}\\p{N}]+",
                    "replacement": " "
                }
            },
            "normalizer": {
                "location_normalizer": {
                    "type": "custom",
                    "char_filter": ["location_char_filter"],
                    "filter": ["lowercase", "asciifolding", "trim"]
                }
            },
            "analyzer": {
                "location_analyzer": {
                    "type": "custom",
                    "char_filter": ["location_char_filter"],
                    "tokenizer": "standard",
                    "filter": ["lowercase", "asciifolding"]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "type": {
                "type": "keyword"
            },
            "label": {
                "type": "keyword",
                "index": false
            },
            "name": {
                "type": "keyword",
                "normalizer": "location_normalizer"
            },
            "search_text": {
                "type": "text",
                "analyzer": "location_analyzer",
                "index_prefixes": {
                    "min_chars": 1,
                    "max_chars": 19
                }
            },
            "location": {
                "type": "geo_point"
            },
            "address_count": {
                "type": "integer"
            }
        }
    }
}
