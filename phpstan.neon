parameters:
	level: 8
	parallel:
		maximumNumberOfProcesses: 1
	paths:
		- app
		- src
		- tests
	excludePaths:
		- app/RoutingServiceProvider.php
	ignoreErrors:
		-
			identifier: missingType.iterableValue
		# The wrapper passes its generic `array $params` straight through, which can't satisfy the
		# required keys in the array shapes the elasticsearch-php 8 client declares for its parameters.
		-
			identifier: argument.type
			path: src/ElasticSearch/Client/*
